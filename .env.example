# ═══════════════════════════════════════════════════════════════
# Overalls Outreach Command Center v2.0 — Environment Config
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL Database ─────────────────────────────────────
# Railway provides this automatically when you add a PostgreSQL addon
DATABASE_URL=postgresql://user:password@localhost:5432/outreach

# ── Authentication ──────────────────────────────────────────
# Generate a random secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# ── Anthropic (Claude API) ──────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-PASTE_YOUR_KEY_HERE

# ── Server Config ───────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Daily Batch Config ──────────────────────────────────────
DAILY_PROSPECT_COUNT=20
DAILY_LINKEDIN_COUNT=5

# ── Apify (LinkedIn Post Search — Optional) ─────────────────
# Get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=PASTE_YOUR_APIFY_TOKEN_HERE

# LinkedIn keyword searches to monitor (comma-separated)
LINKEDIN_SEARCH_KEYWORDS=employee benefits caregiving,point solution bloat,total rewards strategy,caregiver support workplace,HR tech benefits consolidation,employee wellbeing programs,working caregivers,benefits navigation
