# ═══════════════════════════════════════════════════════════════
# Overalls Outreach Automation — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Anthropic (Claude API) ────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-PASTE_YOUR_KEY_HERE

# ── Google Cloud / Sheets API ─────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
# Create a "Service Account" key, download JSON, and paste the path
GOOGLE_SERVICE_ACCOUNT_PATH=./google-service-account.json

# ── Google Sheets IDs ─────────────────────────────────────────
# The long string in the Google Sheet URL between /d/ and /edit
# Example: https://docs.google.com/spreadsheets/d/THIS_PART/edit
PROSPECTS_SHEET_ID=PASTE_YOUR_PROSPECTS_SHEET_ID_HERE
CONTACTS_SHEET_ID=PASTE_YOUR_CONTACTS_SHEET_ID_HERE

# ── Gmail OAuth ───────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
# Create "OAuth 2.0 Client ID" (Desktop app), download JSON
GMAIL_CREDENTIALS_PATH=./gmail-credentials.json
GMAIL_TOKEN_PATH=./gmail-token.json

# ── Server Config ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Daily Batch Config ────────────────────────────────────────
DAILY_PROSPECT_COUNT=20
DAILY_CONTACT_COUNT=5
DAILY_LINKEDIN_COUNT=5

# ── Phantombuster (Optional — for LinkedIn scanning) ──────────
# Get from: https://phantombuster.com/account
PHANTOMBUSTER_API_KEY=PASTE_YOUR_KEY_HERE_OR_LEAVE_BLANK
